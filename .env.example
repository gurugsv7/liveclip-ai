# LiveClip AI environment. Copy to .env (setup.ps1 does this). Nothing here is required.

# Where recordings, clips, exports, models, logs and the database live.
# Use a fast local disk with ~100 GB free; avoid OneDrive/Dropbox-synced folders
# (the rolling buffer creates and deletes a file every few seconds).
# LIVECLIP_DATA_DIR=D:\LiveClipData

# Tool paths (auto-detected from PATH or %LOCALAPPDATA%\LiveClipTools otherwise)
# LIVECLIP_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# LIVECLIP_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# LIVECLIP_STREAMLINK=C:\path\to\streamlink.exe

# Bind address/port (localhost only unless LIVECLIP_I_UNDERSTAND_LAN=1)
LIVECLIP_HOST=127.0.0.1
LIVECLIP_PORT=8765

# Twitch viewer clips (strongly recommended): every clip a viewer makes becomes a saved moment.
# Free: https://dev.twitch.tv/console -> Register Your Application (category: Application Integration,
# OAuth redirect http://localhost) -> copy the Client ID and create a Client Secret.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# YouTube live chat (YouTube Data API v3 key, free quota 10k units/day). Optional.
# YOUTUBE_API_KEY=

# Kick chat uses an undocumented public socket; off unless you opt in.
# LIVECLIP_KICK_CHAT=1

# Allow local:<fixture> test sources (demo/testing).
# LIVECLIP_ALLOW_LOCAL=1
